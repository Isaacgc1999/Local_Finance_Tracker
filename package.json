{
  "name": "fintrack",
  "version": "0.1.0",
  "description": "Fintrack — finanzas personales de escritorio, local y offline (Tauri v2 + Angular 21)",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "tauri dev",
    "build": "ng build",
    "build:desktop": "tauri build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tauri": "tauri",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:all": "npm run test && npm run test:node",
    "bench": "vitest run --config vitest.node.config.ts scripts/bench-analytics.spec.ts",
    "build:demo": "ng build --configuration demo",
    "serve:demo": "node tools/serve-static.mjs dist/fintrack/browser 4300"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "~21.2.22",
    "@angular/compiler": "~21.2.22",
    "@angular/core": "~21.2.22",
    "@angular/forms": "~21.2.22",
    "@angular/platform-browser": "~21.2.22",
    "@angular/router": "~21.2.22",
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "docx": "^9.7.1",
    "echarts": "^6.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "uuid": "^14.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@angular/build": "~21.2.23",
    "@angular/cli": "~21.2.23",
    "@angular/compiler-cli": "~21.2.22",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.1",
    "@types/sql.js": "^1.4.11",
    "jsdom": "^27.1.0",
    "sql.js": "^1.14.2",
    "typescript": "~5.9.2",
    "vitest": "~4.0.8"
  }
}
