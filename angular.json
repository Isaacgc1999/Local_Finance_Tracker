{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "fintrack": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "ft",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": true
            },
            "define": {
              "FT_BROWSER_DEMO": "false"
            },
            "allowedCommonJsDependencies": [
              "canvg",
              "core-js",
              "raf",
              "rgbcolor",
              "html2canvas",
              "dompurify"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "define": {
                "FT_BROWSER_DEMO": "true"
              },
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "sql-wasm*.wasm",
                  "input": "node_modules/sql.js/dist",
                  "output": "assets/sqljs"
                }
              ]
            },
            "test": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "define": {
                "FT_BROWSER_DEMO": "false"
              }
            },
            "demo": {
              "outputHashing": "all",
              "define": {
                "FT_BROWSER_DEMO": "true"
              },
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "sql-wasm*.wasm",
                  "input": "node_modules/sql.js/dist",
                  "output": "assets/sqljs"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "400kB",
                  "maximumError": "600kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "fintrack:build:production"
            },
            "development": {
              "buildTarget": "fintrack:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "exclude": [
              "**/*.node.spec.ts"
            ],
            "buildTarget": "fintrack:build:test"
          }
        }
      }
    }
  }
}
