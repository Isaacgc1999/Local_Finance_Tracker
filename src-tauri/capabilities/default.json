{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de Fintrack: SQLite en appData, diálogos nativos, ficheros de la app, avisos del sistema y HTTP solo hacia Ollama en localhost:11434 y, para los precios de Inversiones, CoinGecko y Yahoo Finance (solo se envían tickers o ISIN).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-remove",

    "notification:default",

    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:11434/*" },
        { "url": "http://localhost:11434/*" },
        { "url": "https://api.coingecko.com/api/v3/*" },
        { "url": "https://query1.finance.yahoo.com/*" },
        { "url": "https://query2.finance.yahoo.com/*" }
      ]
    }
  ]
}
