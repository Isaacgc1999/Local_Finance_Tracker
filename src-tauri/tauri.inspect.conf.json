{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.fintrack.app.inspect",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fintrack",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0A0B0D",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=es-ES --remote-debugging-port=9433"
      }
    ]
  }
}
