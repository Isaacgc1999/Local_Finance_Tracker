{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fintrack",
  "version": "0.1.0",
  "identifier": "com.fintrack.app",
  "build": {
    "beforeDevCommand": "npm run start -- --port 4200",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/fintrack/browser"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Fintrack",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0A0B0D",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=es-ES"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "publisher": "Fintrack",
    "copyright": "© 2026 Fintrack",
    "shortDescription": "Finanzas personales, locales y sin conexión",
    "longDescription": "Fintrack registra tus movimientos en una base de datos SQLite de tu propio equipo. Funciona sin conexión: la única red que usa es la que va a Ollama en tu máquina para el informe semanal.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish", "English"],
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
